*service-account*.json
*credentials*.json
google-services.json
GoogleService-Info.plist
*.kdbx
/private-notes/

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# local source drops, not part of the app
/uploads
/agent-tools

# browser checks
/test-results/
/playwright-report/
/blob-report/
