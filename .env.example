# Copy to .env if you keep local-only values. .env is gitignored.
# Names only. Leave values empty.

# The reader does not load API keys from the environment.
# Paste a Gemini key in Settings. It stays in device secure storage,
# or in browser local storage on the web preview.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# EXPO_PUBLIC_GEMINI_API_KEY=

# Playwright reads this from the process environment, not from .env:
#   FOLIO_LIVE_ARCHIVE=1 npm run test:ui
FOLIO_LIVE_ARCHIVE=

# The Expo / EAS CLI reads this from the process environment when publishing.
# The app does not bundle it.
# EXPO_TOKEN=
